# Shared compose values — used by the `local` postgres profile and baked
# into the backend's DATABASE_URL in docker-compose.yml. No secrets here;
# the deployed environment overrides these with its own.
POSTGRES_USER=app
POSTGRES_PASSWORD=app_secret
POSTGRES_DB=app

# Optional overrides, see docker-compose.yml for defaults.
# BACKEND_PORT=8080
# FRONTEND_PORT=3000

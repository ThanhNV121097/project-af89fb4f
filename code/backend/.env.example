# Postgres DSN. Injected by the runtime (docker-compose.yml locally, the
# deployer in production) — the backend reads it whole, never assembled from
# separate DB_* parts.
DATABASE_URL=postgres://app:app_secret@localhost:5432/app?sslmode=disable

# HTTP listen port. Injected by the runtime; falls back to APP_PORT, then 8080.
PORT=8080

# Signs/verifies session JWTs (docs/architecture/services.md §2.2). Generated
# once at deploy time; the admins/telegram reads in this module verify a
# token independently of the login endpoint that issues one.
JWT_SIGNING_SECRET=change-me-to-a-long-random-string
